---
import { getCollection, type CollectionEntry } from 'astro:content';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import PageHeader from '@sections/content/PageHeader.astro';
import BreadcrumbNav from '@/components/common/BreadcrumbNav.astro';
import CmsEntryList from '@/components/common/CmsEntryList.astro';
import { siteConfig } from '@/config';
import { articleCategoryLabel, formatCmsDate, isPublicCmsEntry } from '@/lib/cms-content';

const articles = (await getCollection('articles'))
  .filter((entry: CollectionEntry<'articles'>) => isPublicCmsEntry(entry))
  .sort(
    (a: CollectionEntry<'articles'>, b: CollectionEntry<'articles'>) =>
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

const title = '記事';
const description =
  'Griftについて書いた記事です。gitの履歴から確かめられる事実と、その読み方を扱います。';
const pageUrl = `${siteConfig.url}/articles/`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${pageUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${siteConfig.url}/` },
    { '@type': 'ListItem', position: 2, name: title, item: pageUrl },
  ],
};
---

<MarketingLayout title={title} description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <BreadcrumbNav items={[{ label: title }]} />
  <PageHeader title={title} subtitle={description} align="left" />
  <section class="pb-section">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <CmsEntryList
        empty="公開中の記事はまだありません。"
        items={articles.map((article: CollectionEntry<'articles'>) => ({
          href: `/articles/${article.id}/`,
          title: article.data.title,
          description: article.data.description,
          meta: `${formatCmsDate(article.data.pubDate)}・${articleCategoryLabel(article.data.category)}`,
        }))}
      />
    </div>
  </section>
</MarketingLayout>
