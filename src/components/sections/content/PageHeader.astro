---
import LbHeading from '@/components/common/LbHeading.astro';
import LbText from '@/components/common/LbText.astro';
/**
 * PageHeader - Reusable page header section with title and subtitle
 *
 * @description
 * A consistent page header component for marketing pages. Supports
 * different alignments, sizes, and optional description text.
 *
 * @example Basic usage
 * ```astro
 * <PageHeader
 *   title="About Us"
 *   subtitle="Learn about our mission and team."
 * />
 * ```
 *
 * @example Left aligned with large title
 * ```astro
 * <PageHeader
 *   title="We're building the future"
 *   subtitle="Our mission is to make deployment effortless."
 *   align="left"
 *   size="large"
 * />
 * ```
 */

interface Props {
  /** Page title (h1) */
  title: string;
  /** Optional subtitle/description */
  subtitle?: string;
  /** Text alignment */
  align?: 'center' | 'left';
  /** Title size */
  size?: 'default' | 'large';
  /** Maximum width for content */
  maxWidth?: 'sm' | 'md' | 'lg' | 'full';
  /** Section background style */
  background?: 'default' | 'muted' | 'accent';
  /** Column width: 'reading' は読み物の列（48rem）に揃える。既定は今のまま */
  width?: 'default' | 'reading';
  /** 公開ページで共通にする見出しサイズと余白（既定は今のまま） */
  variant?: 'default' | 'landing';
}

const {
  title,
  subtitle,
  align = 'center',
  size = 'default',
  maxWidth = 'lg',
  background = 'default',
  width = 'default',
  variant = 'default',
} = Astro.props;

const landing = variant === 'landing';

const bgClass = landing
  ? 'bg-white dark:bg-background'
  : {
      default: 'bg-background',
      muted: 'bg-surface',
      accent: 'bg-primary/5',
    }[background];

const sectionClass = landing ? 'border-b border-border/60 py-10 sm:py-14' : 'py-section';

const alignClass = align === 'left' ? 'text-left' : 'text-center';

const titleSizeClass = landing
  ? 'text-3xl sm:text-4xl lg:text-5xl'
  : size === 'large'
    ? 'text-4xl sm:text-5xl lg:text-6xl'
    : 'text-4xl sm:text-5xl';

const maxWidthClass = {
  sm: 'max-w-xl',
  md: 'max-w-2xl',
  lg: 'max-w-3xl',
  full: 'max-w-none',
}[maxWidth];

const containerClass = align === 'center' ? `${maxWidthClass} mx-auto` : maxWidthClass;

const reading = width === 'reading';
---

<section class:list={[sectionClass, bgClass]}>
  <div
    class:list={[
      reading
        ? 'max-w-reading mx-auto px-4 sm:px-6 lg:px-8'
        : 'max-w-7xl mx-auto px-4 sm:px-6 lg:px-8',
    ]}
  >
    <div class:list={[reading ? '' : containerClass, alignClass]}>
      <LbHeading
        as="h1"
        class={`font-bold text-balance text-text leading-[1.15] ${titleSizeClass}`}
        text={title}
      />
      {
        subtitle && (
          <p
            class:list={[
              'mt-6 max-w-[40em] text-pretty text-lg leading-8 text-text-muted',
              landing && align === 'center' && 'mx-auto',
            ]}
          >
            <LbText>{subtitle}</LbText>
          </p>
        )
      }
      <slot />
    </div>
  </div>
</section>
