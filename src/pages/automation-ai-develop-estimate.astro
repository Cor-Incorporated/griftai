                      >上流工程を効率化するAIツール！機能と選定基準を解説</a>
                  </li>
                </ol>
              </div>
            </section>
            <!-- コンテンツ一覧ここまで -->

            <!-- NAP情報ここから -->
            <section class="u-mt50 c-nap">
              <h3 class="u-mb20">AI開発の見積もり・自動化のご相談はCor.株式会社へ</h3>
              <table class="c-table">
                <tr>
                  <th class="u-p20">会社名</th>
