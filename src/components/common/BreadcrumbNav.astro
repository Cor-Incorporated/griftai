---
/**
 * BreadcrumbNav — 可視パンくずリスト
 *
 * SEO.astro の自動 BreadcrumbList（JSON-LD）と対になる可視ナビゲーション。
 * 内部リンク強化と回遊性向上（滞在時間）が目的。
 * 先頭は常にトップ、末尾は現在ページ（リンクなし）。
 */

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  /** 幅。既定は今のまま（max-w-7xl = 80rem）。reading で読み物の列（48rem）に揃える */
  width?: 'default' | 'reading';
}

const { items, width = 'default' } = Astro.props;
const trail: BreadcrumbItem[] = [{ label: 'トップ', href: '/' }, ...items];
---

<nav aria-label="パンくずリスト" class="bg-background">
  <div
    class:list={[
      'mx-auto px-4 pt-6 sm:px-6 lg:px-8',
      width === 'reading' ? 'max-w-reading' : 'max-w-7xl',
    ]}
  >
    <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-text-muted">
      {
        trail.map((item, index) => {
          const isLast = index === trail.length - 1;
          return (
            <li class="flex items-center gap-2">
              {index > 0 && (
                <span aria-hidden="true" class="text-text-muted/50">
                  /
                </span>
              )}
              {item.href && !isLast ? (
                <a
                  href={item.href}
                  class="inline-flex min-h-11 min-w-11 items-center justify-center transition-colors hover:text-primary"
                >
                  {item.label}
                </a>
              ) : (
                <span aria-current={isLast ? 'page' : undefined} class={isLast ? 'text-text' : ''}>
                  {item.label}
                </span>
              )}
            </li>
          );
        })
      }
    </ol>
  </div>
</nav>
