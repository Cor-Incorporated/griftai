---
import { getCollection, type CollectionEntry } from 'astro:content';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import PageHeader from '@sections/content/PageHeader.astro';
import BreadcrumbNav from '@/components/common/BreadcrumbNav.astro';
import CmsEntryList from '@/components/common/CmsEntryList.astro';
import { siteConfig } from '@/config';
import { formatCmsDate, isPublicCmsEntry, newsCategoryLabel } from '@/lib/cms-content';

const entries = (await getCollection('news'))
  .filter((entry: CollectionEntry<'news'>) => isPublicCmsEntry(entry))
  .sort(
    (a: CollectionEntry<'news'>, b: CollectionEntry<'news'>) =>
      b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
  );

const title = 'お知らせ';
const description = 'Griftと、運営するCor.株式会社からのお知らせです。';
const pageUrl = `${siteConfig.url}/news/`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${pageUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${siteConfig.url}/` },
    { '@type': 'ListItem', position: 2, name: title, item: pageUrl },
  ],
};
---

<MarketingLayout title={title} description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <BreadcrumbNav items={[{ label: title }]} />
  <PageHeader title={title} subtitle={description} align="left" />
  <section class="pb-section">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <CmsEntryList
        empty="公開中のお知らせはまだありません。"
        items={entries.map((entry: CollectionEntry<'news'>) => ({
          href: `/news/${entry.id}/`,
          title: entry.data.title,
          description: entry.data.description,
          meta: `${formatCmsDate(entry.data.publishedAt)}・${newsCategoryLabel(entry.data.category)}`,
        }))}
      />
    </div>
  </section>
</MarketingLayout>
