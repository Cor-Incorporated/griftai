---
import BaseLayout from './BaseLayout.astro';
import Header from '@layout/Header.astro';
import Footer from '@layout/Footer.astro';
import AnnouncementBar from '@layout/AnnouncementBar.astro';
import StructuredData from '@components/common/StructuredData.astro';
import ScrollChrome from '@components/common/ScrollChrome.astro';
import { siteConfig } from '@/config';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  titleTag?: string;
  ogTitle?: string;
  ogDescription?: string;
  // Article-specific props for JSON-LD
  publishedDate?: Date;
  modifiedDate?: Date;
  author?: string;
  tags?: string[];
  faqItems?: Array<{ question: string; answer: string }>;
}

const {
  title,
  description,
  image,
  type = 'website',
  titleTag,
  ogTitle,
  ogDescription,
  publishedDate,
  modifiedDate,
  author,
  tags,
  faqItems,
} = Astro.props;

const { announcement } = siteConfig;
const isHome = Astro.url.pathname === '/';
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  type={type}
  titleTag={titleTag}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  publishedDate={publishedDate}
  modifiedDate={modifiedDate}
  author={author}
  tags={tags}
>
  {
    /* Organization schema は SEO.astro が全ページに @id 付きで出力するため、
      ここでは重複発行しない（SoftwareApplication / FAQ / HowTo のみ）。 */
  }
  {isHome && <StructuredData type="software" />}
  {faqItems && faqItems.length > 0 && <StructuredData type="faq" faqItems={faqItems} />}
  <div class="flex flex-col min-h-screen">
    {
      announcement.enabled && (
        <AnnouncementBar
          id={announcement.id}
          text={announcement.text}
          href={announcement.href}
          linkText={announcement.linkText}
          variant={announcement.variant}
          dismissible={announcement.dismissible}
        />
      )
    }
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </div>
  <ScrollChrome />

  <script>
    let revealObserver: IntersectionObserver | null = null;

    const initScrollAnimations = (): void => {
      // View Transitions のページ遷移では前ページの observer を破棄してから再構築する
      if (revealObserver) {
        revealObserver.disconnect();
        revealObserver = null;
      }

      const targets = document.querySelectorAll(
        '.section-animate, .fade-in-section, .stagger-children'
      );
      if (targets.length === 0) return;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) {
        for (const el of targets) {
          el.classList.add('is-visible');
        }
        return;
      }

      revealObserver = new IntersectionObserver(
        (entries: IntersectionObserverEntry[]) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              revealObserver?.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );

      for (const el of targets) {
        revealObserver.observe(el);
      }
    };

    // 初回表示 + ClientRouter のページ遷移後の両方で発火させる
    document.addEventListener('astro:page-load', initScrollAnimations);
  </script>
</BaseLayout>
