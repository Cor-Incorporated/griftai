                  <th class="u-p20">URL</th>
                  <td class="u-p20"><a href="/">https://griftai.org</a></td>
                </tr>
              </table>
            </section>
            <!-- NAP情報ここまで -->
          </div>
        </div>
        <!-- CSSここから -->
        <style is:global>
.c-head-mv { background-image: url('/images/columns/head-mv-08.jpg'); }
</style>
        <!-- CSSここまで -->
        <script type="application/ld+json" is:inline>
          {
            "@context": "https://schema.org",
            "@type": "FAQPage",
