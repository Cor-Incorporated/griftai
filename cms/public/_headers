/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' blob: data: https://*.githubusercontent.com; media-src blob:; frame-src blob:; worker-src 'self' blob:; connect-src 'self' blob: data: https://api.github.com https://www.githubstatus.com; manifest-src blob:; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
