---
import LbHeading from '@/components/common/LbHeading.astro';
import LbText from '@/components/common/LbText.astro';

/**
 * NextStep — ページ末の誘導CTAカード（corsweb NextStep.astro 移植）
 *
 * 読了したユーザーを次の関連ページ・相談導線へ誘導し、
 * サイト内回遊と滞在時間を伸ばす。griftai のトークン（cta-primary/secondary,
 * border-border, bg-surface）で再実装。
 */

interface Cta {
  label: string;
  href: string;
  /** true で target=_blank + rel=noreferrer */
  isExternal?: boolean;
  /** true で cta-primary、false で cta-secondary */
  primary?: boolean;
}

interface Props {
  heading: string;
  lead?: string;
  ctas: Cta[];
  /** 幅。既定は今のまま（max-w-5xl = 64rem）。reading で読み物の列（48rem）に揃える */
  width?: 'default' | 'reading';
  /** card の中の揃え。既定は今のまま（中央）。left で左に揃える */
  align?: 'center' | 'left';
}

const { heading, lead, ctas, width = 'default', align = 'center' } = Astro.props;
const alignLeft = align === 'left';
---

<section class="bg-background py-section">
  <div
    class:list={[
      'mx-auto px-4 sm:px-6 lg:px-8',
      width === 'reading' ? 'max-w-reading' : 'max-w-5xl',
    ]}
  >
    <div
      class:list={[
        'flex flex-col gap-8 rounded-3xl border border-border bg-surface px-6 py-12 sm:px-12 sm:py-16',
        alignLeft ? 'items-start text-left' : 'items-center text-center',
      ]}
    >
      <div class="flex w-full max-w-2xl flex-col gap-4">
        <p class="text-sm font-semibold text-primary">次の一歩</p>
        <LbHeading
          as="h2"
          class="text-balance text-2xl font-bold text-text sm:text-3xl"
          text={heading}
        />
        {
          lead && (
            <p class="text-pretty text-lg leading-8 text-text-muted">
              <LbText>{lead}</LbText>
            </p>
          )
        }
      </div>
      <div
        class:list={[
          'flex w-full flex-col gap-3 sm:w-auto sm:flex-row',
          alignLeft ? 'items-start sm:justify-start' : 'items-center sm:justify-center',
        ]}
      >
        {
          ctas.map((cta) => (
            <a
              href={cta.href}
              target={cta.isExternal ? '_blank' : undefined}
              rel={cta.isExternal ? 'noreferrer' : undefined}
              class:list={[cta.primary ? 'cta-primary' : 'cta-secondary', 'w-full sm:w-auto']}
            >
              {cta.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
