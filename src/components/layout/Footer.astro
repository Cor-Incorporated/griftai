---
import {
  SITE_CHROME,
  commonLinksFor,
  griftCli,
  siteChromeOrganization,
  siteChromeYear,
  siteConfig,
} from '@/config';
import type { FeatureFlags, NavigationItem } from '@/lib/types';
import { corCta } from '@/lib/cor-cta';
import Fukuoka100Emblem from '@/components/common/Fukuoka100Emblem.astro';

const { features, contact, navigation } = siteConfig;
const { footer } = navigation;
const currentYear = siteChromeYear();
const organizationName = siteChromeOrganization('ja');
const chromeLinks = commonLinksFor('ja');
const trialUrl = corCta.griftTrial('grift-nav-footer');

const filterByFeature = (items: NavigationItem[]) =>
  items.filter((item) => !item.feature || features[item.feature as keyof FeatureFlags]);

const productLinks = filterByFeature(footer.product);
const solutionsLinks = filterByFeature(footer.solutions);
const resourcesLinks = filterByFeature(footer.resources);
const companyLinks = filterByFeature(footer.company);
---

<footer class="border-t border-border bg-surface">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-6 lg:gap-12">
      <div class="col-span-2 mb-4 sm:col-span-3 lg:col-span-2 lg:mb-0">
        <a href="/" class="inline-flex items-center gap-3 text-lg font-semibold text-text">
          <img
            src="/grift-wordmark-120.jpg"
            alt={`${siteConfig.name} ロゴ`}
            width="32"
            height="32"
            class="h-8 w-auto rounded-sm"
            loading="lazy"
          />
        </a>
        <p class="mt-3 max-w-sm text-sm leading-7 text-text-muted text-pretty">
          {siteConfig.description}
        </p>
        {
          /* 福岡を代表する企業100選 公式エンブレム。フッターは全ページに出るため、
            どのページから流入した人にも届く。掲載条件はコンポーネント側で担保。 */
        }
        <Fukuoka100Emblem imgClass="h-16 w-auto" class="mt-5" />
        <div class="mt-4 space-y-1 text-sm text-text-muted">
          <p>
            {contact.address.state}
            {contact.address.city}
            {contact.address.country}
          </p>
          <p class="pt-2">
            <a
              href={trialUrl}
              target="_blank"
              rel="noreferrer"
              class="transition-colors hover:text-text"
            >
              自社でテストしてみる（紹介会社さま・SES企業さま）
            </a>
          </p>
          <p>
            <a
              href={griftCli.github}
              target="_blank"
              rel="noreferrer"
              class="transition-colors hover:text-text"
            >
              GitHubでGrift CLIを見る（エンジニアの方）
            </a>
          </p>
        </div>
      </div>

      {
        productLinks.length > 0 && (
          <div>
            <h3 class="mb-4 text-sm font-semibold text-text">Grift</h3>
            <ul class="space-y-3">
              {productLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-text-muted transition-colors hover:text-text"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        solutionsLinks.length > 0 && (
          <div>
            <h3 class="mb-4 text-sm font-semibold text-text">使い方</h3>
            <ul class="space-y-3">
              {solutionsLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-text-muted transition-colors hover:text-text"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        resourcesLinks.length > 0 && (
          <div>
            <h3 class="mb-4 text-sm font-semibold text-text">案内</h3>
            <ul class="space-y-3">
              {resourcesLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-text-muted transition-colors hover:text-text"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        companyLinks.length > 0 && (
          <div>
            <h3 class="mb-4 text-sm font-semibold text-text">運営会社</h3>
            <ul class="space-y-3">
              {companyLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.href.startsWith('http') ? '_blank' : undefined}
                    rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
                    class="text-sm text-text-muted transition-colors hover:text-text"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>

  <div class="border-t border-border bg-surface text-[13px] leading-[1.4] text-text-muted lg:h-16">
    <div
      class="flex flex-col items-start gap-2.5 px-3 py-4 text-left lg:h-full lg:flex-row lg:items-center lg:gap-6 lg:px-6 lg:py-0"
    >
      <p class="whitespace-nowrap">&copy; {currentYear} {organizationName}</p>

      <nav
        aria-label="共通リンク"
        class="flex flex-wrap items-center gap-x-4 gap-y-2.5 lg:flex-1 lg:justify-center lg:gap-6"
      >
        {
          chromeLinks.map((link) => (
            <a
              href={link.href}
              rel="noopener"
              class="inline-flex min-h-6 items-center text-text no-underline transition-colors hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <nav aria-label="サイト切替" class="flex items-center gap-3.5 lg:gap-4">
        {
          SITE_CHROME.sites.map((site) => {
            const current = site.id === 'grift';
            return (
              <a
                href={site.href}
                rel="noopener"
                aria-current={current ? 'page' : undefined}
                class:list={[
                  'inline-flex min-h-6 items-center no-underline transition-colors hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary',
                  current ? 'font-bold text-text' : 'text-text-muted',
                ]}
              >
                {site.label}
              </a>
            );
          })
        }
      </nav>
    </div>
  </div>
</footer>
