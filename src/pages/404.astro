---
import ErrorLayout from '@/layouts/ErrorLayout.astro';
import ErrorPage from '@components/error/ErrorPage.astro';
---

<ErrorLayout
  title="ページが見つかりません"
  description="お探しのページは存在しないか、移動された可能性があります。"
>
  <ErrorPage
    code={404}
    title="ページが見つかりません"
    message="お探しのページは、移動または削除されたか、公開を終了した可能性があります。トップページか各メニューから、もう一度ご確認ください。"
  />
</ErrorLayout>
