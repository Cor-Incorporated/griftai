---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import BreadcrumbNav from '@/components/common/BreadcrumbNav.astro';
import ArticleAuthor from '@/components/common/ArticleAuthor.astro';
import DocumentDownload from '@/components/common/DocumentDownload.astro';
import NextStep from '@/components/common/NextStep.astro';
import { griftCli, siteConfig } from '@/config';
import { corCta } from '@/lib/cor-cta';
import { formatCmsDate, isPublicCmsEntry, newsCategoryLabel } from '@/lib/cms-content';

export async function getStaticPaths() {
  const entries = (await getCollection('news')).filter((entry: CollectionEntry<'news'>) =>
    isPublicCmsEntry(entry)
  );
  return entries.map((entry: CollectionEntry<'news'>) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'news'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const pageUrl = `${siteConfig.url}/news/${entry.id}/`;
const contactUrl = corCta.griftTrial(`grift-news-${entry.id}`);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${pageUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${siteConfig.url}/` },
    { '@type': 'ListItem', position: 2, name: 'お知らせ', item: `${siteConfig.url}/news/` },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: pageUrl },
  ],
};
---

<MarketingLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  publishedDate={entry.data.publishedAt}
  modifiedDate={entry.data.updatedAt}
  tags={entry.data.tags}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <BreadcrumbNav items={[{ label: 'お知らせ', href: '/news/' }, { label: entry.data.title }]} />
  <article class="pb-section">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <header class="mt-8 space-y-4">
        <p class="text-sm font-semibold text-primary">
          {newsCategoryLabel(entry.data.category)}・{formatCmsDate(entry.data.publishedAt)}
        </p>
        <h1 class="text-3xl font-bold text-balance text-text sm:text-4xl">{entry.data.title}</h1>
        <p class="text-lg leading-8 text-text-muted text-pretty">{entry.data.description}</p>
      </header>
      <div
        class="prose prose-lg mt-10 max-w-none dark:prose-invert prose-headings:text-text prose-a:text-primary"
      >
        <Content />
      </div>
      {
        entry.data.externalUrl && (
          <p class="mt-8 text-sm">
            <a
              href={entry.data.externalUrl}
              class="font-semibold text-primary hover:underline"
              target="_blank"
              rel="noreferrer"
            >
              {entry.data.source ? `${entry.data.source}を開く` : '掲載元を開く'}
            </a>
          </p>
        )
      }
      <div class="mt-14">
        <ArticleAuthor />
      </div>
      <div class="mt-14">
        <DocumentDownload />
      </div>
    </div>
  </article>
  <NextStep
    heading="自社の推薦業務で、確かめてみませんか。"
    lead="紹介会社さま・SES企業さまのテスト導入（PoC）は、Cor.株式会社のAI受付で承っています。エンジニアの方は、GitHubからすぐに試せます。"
    ctas={[
      { label: '自社でテストしてみる', href: contactUrl, primary: true, isExternal: true },
      { label: 'GitHubでGrift CLIを見る', href: griftCli.github, isExternal: true },
    ]}
  />
</MarketingLayout>
