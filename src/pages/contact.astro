---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import PageHeader from '@sections/content/PageHeader.astro';
import BreadcrumbNav from '@/components/common/BreadcrumbNav.astro';
import DocumentDownload from '@/components/common/DocumentDownload.astro';
import { Icon } from 'astro-icon/components';
import { contactMethods, siteConfig } from '@/config';
import { corCta, getCorUrl } from '@/lib/cor-cta';

const contactUrl = corCta.griftTrial('grift-contact');
const corHomeUrl = getCorUrl('/');
const phone = siteConfig.contact.phone;
const phoneUrl = `tel:${phone.replaceAll('-', '')}`;
---

<MarketingLayout
  title={`お問い合わせ - ${siteConfig.name}`}
  description="Grift のテスト導入（PoC）の相談・お問い合わせ窓口。人材紹介会社・SES企業さまからのご相談を、Cor.株式会社のAI受付と電話窓口でお受けします。"
>
  <BreadcrumbNav items={[{ label: 'お問い合わせ' }]} />
  <PageHeader
    title="お問い合わせ"
    subtitle="紹介会社さま・SES企業さまのテスト導入（PoC）のご相談、Grift CLI に関するお問い合わせはこちらからご連絡ください。"
  />

  <section class="bg-background py-section">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr]">
        <article class="rounded-3xl border border-border bg-surface p-8">
          <p class="text-sm font-semibold text-primary">相談窓口</p>
          <h2 class="mt-3 text-balance text-3xl font-bold text-text">
            Grift の相談は Cor.株式会社のAI受付へ。
          </h2>
          <p class="mt-4 text-pretty text-lg leading-8 text-text-muted">
            紹介会社さま・SES企業さまのテスト導入（PoC）、費用の確認、Grift CLI
            の使い方に関するご相談はAI受付で受け付けています。推薦業務の流れと、相談したい内容が分かるとスムーズです。
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href={contactUrl}
              class="inline-flex items-center justify-center rounded-md bg-primary px-6 py-3 font-medium text-white transition-colors hover:bg-primary-dark"
            >
              Cor.株式会社のAI受付へ
            </a>
            <a
              href={phoneUrl}
              class="inline-flex items-center justify-center rounded-md border border-border px-6 py-3 font-medium text-text transition-colors hover:bg-background"
            >
              電話（{phone}）で相談する
            </a>
            <a
              href={corHomeUrl}
              class="inline-flex items-center justify-center rounded-md border border-border px-6 py-3 font-medium text-text transition-colors hover:bg-background"
            >
              Cor.株式会社 のサイトを見る
            </a>
          </div>
        </article>

        <article class="rounded-3xl border border-border bg-surface p-8">
          <p class="text-sm font-semibold text-primary">事前にあるとよい情報</p>
          <h2 class="mt-3 text-2xl font-bold text-text">問い合わせ時にあると助かる情報</h2>
          <ul class="mt-6 space-y-4 text-text-muted">
            <li class="flex gap-3">
              <Icon name="lucide:check" class="mt-1 size-5 text-primary" />
              <span>会社の種類: 人材紹介会社、SES企業、そのほか</span>
            </li>
            <li class="flex gap-3">
              <Icon name="lucide:check" class="mt-1 size-5 text-primary" />
              <span>推薦の対象: 職種や月あたりのおおよその推薦件数</span>
            </li>
            <li class="flex gap-3">
              <Icon name="lucide:check" class="mt-1 size-5 text-primary" />
              <span>いま推薦の理由をどうまとめているか</span>
            </li>
            <li class="flex gap-3">
              <Icon name="lucide:check" class="mt-1 size-5 text-primary" />
              <span>テスト導入の相談、CLIの使い方、そのほかのどれに近いか</span>
            </li>
          </ul>
          <div class="mt-8 space-y-3">
            {
              contactMethods.map((method) => (
                <a
                  href={method.href}
                  class="flex items-center gap-3 rounded-xl border border-border bg-background px-4 py-3 text-sm font-medium text-text transition-colors hover:border-primary/40"
                >
                  <Icon name={method.icon} class="size-4 text-primary" />
                  <span class="flex flex-col">
                    <span class="text-xs font-semibold text-primary">{method.label}</span>
                    <span>{method.value}</span>
                  </span>
                </a>
              ))
            }
          </div>
        </article>
      </div>
    </div>
  </section>
  <section class="bg-background pb-section">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <DocumentDownload />
    </div>
  </section>
</MarketingLayout>
