---
/**
 * ProductShowcase - What Grift CLI observes
 *
 * @description
 * Lists the observation layers Grift CLI (TEP) reports from git history.
 * Wording follows the public metrics guide in Cor-Incorporated/grift-cli
 * (docs/metrics-guide.md). Do not add metrics here that the CLI does not emit.
 *
 * @example
 * ```astro
 * <ProductShowcase />
 * ```
 */
import { griftCli } from '@/config';

interface ObservationLayer {
  /** 層の名前 */
  layer: string;
  /** その層が答える問い */
  question: string;
  /** 主な観測（CLI の英語名を併記） */
  items: Array<{ name: string; detail: string }>;
}

const layers: ObservationLayer[] = [
  {
    layer: '帰属',
    question: 'このコミットは、誰の・何の仕事か',
    items: [
      {
        name: '帰属の区別（origin・11分類）',
        detail:
          '本人の独自コミット、他人の仕事、bot、生成・ベンダー成果物、fork元から引き継いだ履歴などを分けて数えます。',
      },
    ],
  },
  {
    layer: '証拠',
    question: '変更に検証が伴っているか',
    items: [
      {
        name: 'テスト併修率（test co-change）',
        detail: '本番コードの変更と同じコミットで、テストも変更している割合。',
      },
      {
        name: '定着率（survival・オプション）',
        detail: '書いた行が180日後も残っている割合。指定したときだけ計測します。',
      },
    ],
  },
  {
    layer: '観測',
    question: 'どんな傾向があるか（合否には使わない）',
    items: [
      {
        name: '手戻り率（corrective rework）',
        detail:
          '直近に触ったファイルを fix / revert でやり直した割合。傾向の記録であり、バグ件数ではありません。',
      },
      {
        name: '磨き直し（path retouch）',
        detail: '同じファイルを短い期間に再び触った割合。',
      },
    ],
  },
  {
    layer: '文脈',
    question: 'どんなリポジトリでの仕事か',
    items: [
      {
        name: 'リポジトリの文脈（context profile）',
        detail:
          '実働日数、関わった人数と最多作成者の占有率、レビュー（PR）経由の割合、言語構成など。分類であって序列ではありません。',
      },
    ],
  },
];
---

<section class="landing-container landing-section">
  <div class="fade-in-section max-w-3xl space-y-4">
    <p class="section-kicker">観測すること</p>
    <h2 class="type-heading text-3xl font-semibold text-text sm:text-4xl">
      誰の仕事か。検証が伴っているか。どんな文脈か。
    </h2>
    <p class="type-copy text-lg text-text-muted">
      Grift
      CLIは、git履歴だけから次の観測を取り出します。どの数値にも分子と分母、計測の条件（定義の版・対象のコミット）が付き、母数が20未満のときは率を出さずに件数だけを示します。
    </p>
  </div>

  <div class="fade-in-section mt-10 surface-panel p-5 sm:p-6 lg:p-8">
    <div class="grid gap-4 lg:grid-cols-2">
      {
        layers.map((layer) => (
          <div class="card-lift rounded-2xl border border-border bg-background p-5">
            <p class="text-xs font-medium text-primary">{layer.layer}</p>
            <p class="mt-1 text-lg font-semibold text-text">{layer.question}</p>
            <dl class="mt-4 space-y-4">
              {layer.items.map((item) => (
                <div>
                  <dt class="text-sm font-semibold text-text">{item.name}</dt>
                  <dd class="mt-1 text-sm leading-6 text-text-muted text-pretty">{item.detail}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))
      }
    </div>

    <p class="mt-4 text-center text-xs leading-6 text-text-muted">
      観測できなかったものは「実績なし」ではなく、理由付きの「未観測（not_observed）」として出します。各指標の読み方は
      <a
        href={griftCli.metricsGuide}
        target="_blank"
        rel="noreferrer"
        class="text-primary underline underline-offset-2">metrics-guide</a
      >
      で平易に解説しています。
    </p>
  </div>
</section>
