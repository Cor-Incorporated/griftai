---
/**
 * StoryCard — Grift のストーリー（架空の物語）へのカード。カード全体を1つのリンクにする。
 * トップの「課題」・コラム一覧・各ストーリーの「ほかのストーリー」で使う。
 */
interface Props {
  href: string;
  /** 課題のラベル（例: 紹介会社・SESの営業） */
  who: string;
  title: string;
  body?: string;
  /** カード下部の誘導文 */
  cta?: string;
  /** 見出しのレベル（ページ内の見出し構造に合わせる） */
  headingLevel?: 'h2' | 'h3';
}

const { href, who, title, body, cta = '物語で読む', headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<a
  href={href}
  class="group flex h-full flex-col rounded-2xl border border-border bg-surface p-6 no-underline transition duration-200 ease-out hover:-translate-y-1 hover:border-primary/45 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
>
  <span class="text-xs font-semibold text-primary">{who}</span>
  <Heading class="mt-2 text-xl font-semibold text-balance text-text group-hover:text-primary">
    {title}
  </Heading>
  {body && <p class="mt-3 flex-1 text-sm leading-7 text-text-muted text-pretty">{body}</p>}
  <span class="mt-4 text-sm font-semibold text-primary">
    {cta}
    <span aria-hidden="true" class="inline-block transition group-hover:translate-x-0.5">→</span>
  </span>
</a>
