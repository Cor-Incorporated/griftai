---
/**
 * PageToc — ページ内目次ナビゲーション
 *
 * 長いページのセクションアンカーへのリンク集。
 * - ユーザーが目的セクションへ直接移動できる（回遊・滞在時間向上）
 * - アンカーリンクは検索エンジン/AIO がページ構造を把握する手がかりにもなる
 */

interface TocItem {
  id: string;
  label: string;
}

interface Props {
  items: TocItem[];
  heading?: string;
}

const { items, heading = 'このページの内容' } = Astro.props;
---

<nav aria-label="ページ内目次" class="border-y border-border bg-surface">
  <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <p class="text-sm font-semibold text-primary">{heading}</p>
    <ol class="mt-3 flex flex-wrap gap-x-2 gap-y-2">
      {
        items.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              class="inline-flex items-center rounded-full border border-border bg-background px-4 py-1.5 text-sm font-medium text-text-muted transition hover:border-primary/50 hover:text-primary"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</nav>
