---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import AgitationSection from '@/components/sections/marketing/AgitationSection.astro';
import ProductShowcase from '@/components/sections/marketing/ProductShowcase.astro';
import SocialProofSection from '@/components/sections/marketing/SocialProofSection.astro';
import FloatingCTA from '@/components/sections/marketing/FloatingCTA.astro';
import ServiceMessageSection from '@/components/sections/marketing/ServiceMessageSection.astro';
import ColumnPromoSection from '@/components/sections/marketing/ColumnPromoSection.astro';
import PageToc from '@/components/common/PageToc.astro';
import NextStep from '@/components/common/NextStep.astro';
import Fukuoka100Emblem from '@/components/common/Fukuoka100Emblem.astro';
import StructuredData from '@/components/common/StructuredData.astro';
import { contentAsOf, griftArticles, griftCli } from '@/config';
import { corCta } from '@/lib/cor-cta';

const heroPrimaryUrl = corCta.griftTrial('grift-lp-hero');
const midCtaUrl = corCta.griftTrial('grift-lp-mid');
const pricingCtaUrl = corCta.griftTrial('grift-lp-pricing-trial');
const finalCtaUrl = corCta.griftTrial('grift-lp-final');

const asOfLabel = new Date(`${contentAsOf}T00:00:00+09:00`).toLocaleDateString('ja-JP', {
  timeZone: 'Asia/Tokyo',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// 3つの約束。ヒーローのチップ・#value・構造化データの説明で同じ言い回しを使う。
const promises = [
  {
    title: '点数にしない',
    lead: '出すのは検査値。判断するのは人です。',
    body: '合成スコア・順位・合否・「シニア／ジュニア」のような等級は出しません。数値には必ず分子と分母を付け、母数が小さいときは率を出さずに件数だけを示します。',
  },
  {
    title: '毎回同じ結果',
    lead: '計測にAI（LLM）を使いません。',
    body: '同じリポジトリ・同じ版なら、誰が実行しても同じ数値になります。指標の定義と検証結果は公開しており、保存したレポートは grift verify で再計算して検算できます。',
  },
  {
    title: 'どこにも送らない',
    lead: '手元のPCだけで動きます。',
    body: '当社へデータを自動で送る機能はありません。privateリポジトリでも、集計値だけを本人の意思で共有できます。共有するかどうか、どのリポジトリを出すかは本人が決めます。',
  },
];

const pains = [
  {
    who: '紹介会社・SESの営業',
    title: '「なぜこの方を薦めるのか」を具体的に言えない',
    body: '経歴書と面談の印象だけでは、推薦の理由が「経験豊富です」「真面目な方です」といった言い換えになりがちです。',
  },
  {
    who: 'エンジニア本人',
    title: '「Java 5年」では中身が伝わらない',
    body: '年数や担当工程だけでは、どんな変更をどう確かめながら進めてきたのか、仕事の仕方が伝わりにくいままです。',
  },
  {
    who: 'AI時代の前提',
    title: 'GitHubの草やコミット数は、AIで量産できる',
    body: '生成AIやエージェントを使えば、活動量は簡単に膨らみます。量の多さだけでは、推薦の根拠になりにくくなりました。',
  },
  {
    who: '数値化の落とし穴',
    title: 'スコアにした途端、条件が見えなくなる',
    body: '1つの点数にまとめると、何を・どの期間で・どの母数で測ったのかが消え、足切りの道具として使われる不安が残ります。',
  },
];

const compareRows = [
  {
    aspect: '根拠の出どころ',
    before: '本人の申告と、面談での印象',
    after: 'git履歴から取り出した事実（検査値）',
  },
  {
    aspect: 'AIによる量産',
    before: 'コミット数・草・行数は簡単に膨らむ',
    after: '本人・他人・bot・自動生成・fork元などを区別して数える',
  },
  {
    aspect: '再現性',
    before: '見る人によって解釈が変わる',
    after: '同じリポジトリ・同じ版なら同じ数値。grift verify で検算できる',
  },
  {
    aspect: '数値の扱い',
    before: 'スコアや順位にすると、条件と限界が消える',
    after: '分子・分母と観測できなかった理由を併記し、点数・順位は出さない',
  },
  {
    aspect: '機密性',
    before: 'privateリポジトリの仕事は見せられない',
    after: '手元で計測し、集計値だけを本人の意思で共有できる',
  },
];

const proofItems = [
  {
    title: '公開117リポジトリで検証',
    body: '指標ごとに、区別できた比較と、まだ区別できていない比較の両方を公開しています。条件を広げて差が小さくなった比較も、基準を下げずにそのまま載せています（社内測定・第三者監査なし）。',
  },
  {
    title: '利用規範（norms）を公開',
    body: '「不在を負に読まない」「数値だけで足切りしない」「本人の同意なく他人を測らない」「監視に転用しない」「重み付けで換算しない」など7条を定め、守らない使い方は TEP と呼ばない決まりにしています。',
  },
  {
    title: '再計算で検算できる',
    body: 'grift verify は保存したレポートを同じ条件で計算し直し、一致（VERIFIED）・不一致（MISMATCH）・検証不能（CANNOT_VERIFY）を返します。書き換えや食い違いを受け取った側で確かめられます。',
  },
];

const flowSteps = [
  {
    step: '01',
    title: '候補者が手元で実行',
    body: '候補者本人が、自分のPCで Grift CLI を実行します。リポジトリやコードは外に出ません。',
  },
  {
    step: '02',
    title: '検算できる事実を共有',
    body: '共有するかどうか、どのリポジトリを出すかは本人が選びます。選んで出したことも、受け取る側に分かる形で残ります。',
  },
  {
    step: '03',
    title: '営業が接点を整理',
    body: '案件で求められることと照らし合わせ、事実との接点と、面談で聞くべきことを整理します。',
  },
  {
    step: '04',
    title: '面談で確かめる',
    body: '数値は合否の基準ではなく、問いのきっかけです。背景や判断の理由は、面談で本人から聞きます。',
  },
  {
    step: '05',
    title: '根拠を添えて推薦',
    body: '「なぜこの方を薦めるのか」を、検算できる事実とともに企業へ伝えます。',
  },
];

const audiences = [
  {
    id: 'for-sales',
    label: '人材紹介会社・SESの営業の方へ',
    title: '「なぜこの方を薦めるのか」を、根拠とともに。',
    situation:
      '経歴書と面談だけでは、推薦の理由が抽象的になりやすい。企業から「この方の強みは？」と聞かれても、具体的な材料を示しにくい。',
    support:
      '候補者本人が共有した記録から、案件との接点と面談で聞くことを整理し、推薦の理由を具体的にします。',
    next: 'いま、紹介会社さま・SES企業さまのテスト導入（PoC）のご相談を受け付けています。費用は対象・件数に応じて個別にご案内します。',
  },
  {
    id: 'for-engineers',
    label: 'エンジニアの方へ',
    title: '経歴書に、検算できる1行を。',
    situation:
      '「Java 5年」と書いても、どんな仕事の仕方をしてきたかは伝わらない。コミット数やGitHubの草は、もう判断材料になりにくい。',
    support: `${griftCli.installCommand} で、手元のPCだけで始められます。無償・MITライセンスのOSSで、結果を出すかどうかは自分で決められます。`,
    next: '指標の読み方は、非エンジニア向けの解説（metrics-guide）も GitHub で公開しています。',
  },
];

const pricingCards = [
  {
    name: 'Grift CLI',
    target: 'エンジニア本人・どなたでも',
    price: '無償（MITライセンス）',
    description: `PyPI と GitHub で公開しています（${griftCli.packageName} v${griftCli.version}）。Python ${griftCli.pythonRequires}の環境で、${griftCli.installCommand} から始められます。`,
    cta: 'GitHubでGrift CLIを見る',
    href: griftCli.github,
    primary: false,
  },
  {
    name: '紹介会社さま向けのテスト導入（PoC）',
    target: '人材紹介会社・SES企業',
    price: '個別にご案内',
    description:
      '対象・件数に応じて、テストの範囲と費用を個別にご案内します。営業向けの画面は、テスト導入に向けて準備を進めています。',
    cta: '自社でテストしてみる',
    href: pricingCtaUrl,
    primary: true,
  },
  {
    name: '正式版',
    target: '紹介会社さま・SES企業さま',
    price: '2027年に提供開始予定',
    description:
      'テスト導入の結果をふまえて、2027年の提供開始を目指しています。価格は正式に決まってからお知らせします。',
    cta: null,
    href: null,
    primary: false,
  },
];

const faqPreview = [
  {
    q: 'Griftとは何ですか？',
    a: 'エンジニアのgit履歴から「確かめられる事実」を取り出すOSSのCLIツールです。点数や順位はつけず、誰が実行しても同じ結果になり、受け取った側が検算できます。人材紹介会社・SESの営業が、推薦の理由を根拠とともに伝えるために使えます。',
  },
  {
    q: 'AIでエンジニアを評価するツールですか？',
    a: 'いいえ。計測にAI（LLM）は使わず、点数・順位・合否も出しません。出すのは分子と分母の付いた検査値で、判断するのは人です。数値だけで足切りする使い方は、利用規範で禁止しています。',
  },
  {
    q: '料金はいくらですか？',
    a: 'Grift CLI は無償（MITライセンス）です。紹介会社さま・SES企業さまのテスト導入（PoC）は、対象・件数に応じて個別にご案内しています。正式版は2027年の提供開始を目指しており、価格は決まってからお知らせします。',
  },
];

// AIO/回答エンジン向けの自己完結型要約。「Griftとは何か」を1ブロックで説明する。
const griftFacts = [
  {
    term: '何をするか',
    detail:
      'エンジニアのgit履歴から、確かめられる事実（検査値）を取り出す。手法の名前はTEP（Technical Evidence Pipeline）',
  },
  {
    term: '誰のためか',
    detail:
      '人材紹介会社・SESの営業（推薦の根拠づくり）と、エンジニア本人（経歴書に検算できる事実を添える）',
  },
  {
    term: '計測のしかた',
    detail:
      'AI（LLM）を使わない決定論的な計測。同じリポジトリ・同じ版なら、誰が実行しても同じ数値になる',
  },
  { term: '出さないもの', detail: '点数・順位・合否・等級。数値には必ず分子と分母を付ける' },
  {
    term: '提供状況',
    detail: `CLIはPyPI・GitHubで公開中（${griftCli.packageName} v${griftCli.version}・${griftCli.license}ライセンス）。紹介会社さま向けの機能はテスト導入を準備中`,
  },
  {
    term: '料金',
    detail: 'CLIは無償。紹介会社さまのテスト導入は個別にご案内。正式版は2027年の提供開始を目指す',
  },
];

const tocItems = [
  { id: 'about', label: 'Griftとは' },
  { id: 'problem', label: '課題' },
  { id: 'value', label: '3つの約束' },
  { id: 'compare', label: '経歴書との違い' },
  { id: 'product', label: '観測すること' },
  { id: 'proof', label: '検証の公開' },
  { id: 'flow', label: '推薦までの流れ' },
  { id: 'scenarios', label: '使う人ごとに' },
  { id: 'pricing', label: '料金と提供状況' },
  { id: 'faq', label: 'よくある質問' },
  { id: 'column-promo', label: 'コラム' },
];
---

<MarketingLayout
  title="Grift｜git履歴から確かめられる事実を取り出すOSS"
  titleTag="Grift｜経歴は盛れる。証拠は盛れない。"
  ogTitle="経歴は盛れる。証拠は盛れない。｜Grift"
  description="Griftは、エンジニアのgit履歴から「確かめられる事実」を取り出すOSSのCLIです。点数や順位はつけず、AI（LLM）を使わないので誰が実行しても同じ結果になり、受け取った側が検算できます。人材紹介会社・SESの営業が推薦の理由を根拠とともに伝えるために使えます。"
  faqItems={faqPreview.map((item) => ({ question: item.q, answer: item.a }))}
>
  <section id="hero" class="section-animate relative bg-background">
    <div class="landing-container py-12 sm:py-16 md:py-20 lg:py-24">
      <div class="mx-auto flex max-w-5xl flex-col items-center gap-5 text-center sm:gap-7">
        <p class="section-kicker">Grift CLI ・ OSS（MITライセンス）</p>
        <h1
          class="type-heading text-[clamp(2.25rem,7vw,5.75rem)] font-semibold leading-[1.05] text-text"
        >
          <span class="block">経歴は盛れる。</span>
          <span class="block">証拠は盛れない。</span>
        </h1>
        <div class="type-copy max-w-3xl space-y-3 text-lg text-text-muted sm:text-xl">
          <p>
            Griftは、エンジニアのgit履歴から「確かめられる事実」を取り出すツールです。点数や順位はつけません。
          </p>
          <p>誰が実行しても同じ結果になり、受け取った側が検算できます。</p>
        </div>
        <div class="flex w-full flex-col items-center gap-3 sm:w-auto sm:flex-row">
          <a
            href={heroPrimaryUrl}
            target="_blank"
            rel="noreferrer"
            class="cta-primary w-full sm:w-auto"
          >
            自社でテストしてみる
          </a>
          <a
            href={griftCli.github}
            target="_blank"
            rel="noreferrer"
            class="cta-secondary w-full sm:w-auto"
          >
            GitHubでGrift CLIを見る
          </a>
        </div>
        <ul class="grid w-full gap-3 text-left text-sm text-text-muted sm:grid-cols-3">
          {
            promises.map((item) => (
              <li class="surface-card p-3 sm:p-4">
                <span class="font-semibold text-text">{item.title}</span>
                <span class="block">{item.lead}</span>
              </li>
            ))
          }
        </ul>
        {
          /* 福岡を代表する企業100選 公式エンブレム。掲載条件（クリック遷移・掲載期限）は
            コンポーネント側で担保。スマホ 56px、sm 以上で 80px。 */
        }
        <Fukuoka100Emblem imgClass="h-14 w-auto sm:h-20" />
      </div>

      <div class="mt-8 grid gap-6 sm:mt-10 lg:mt-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-stretch">
        <figure
          id="product-demo"
          class="surface-panel min-w-0 overflow-hidden p-0"
          aria-label="Grift CLI の使い方の例"
        >
          <div class="bg-text p-4 sm:p-6">
            <pre
              class="text-xs leading-7 break-words whitespace-pre-wrap text-background sm:text-sm"><code><span class="text-background/60"># インストール（Python 3.11以上）</span>
<span class="text-secondary">$</span> {griftCli.installCommand}

<span class="text-background/60"># 計測して .grift/report.json と report.md に記録</span>
<span class="text-secondary">$</span> cd your-repo
<span class="text-secondary">$</span> grift report

<span class="text-background/60"># 同じ条件で再計算し、書き換えや食い違いを検出</span>
<span class="text-secondary">$</span> grift verify
VERIFIED: all fields match recomputation under recorded provenance

<span class="text-background/60"># 出力の一例（数値には必ず分子と分母が付く）</span>
test co-change: 0.2664 ratio（73 of 274）</code></pre>
          </div>
          <figcaption
            class="border-t border-border px-4 py-3 text-xs leading-6 text-text-muted sm:px-6"
          >
            出力の一例は、Grift CLI の README
            に載せている公開リポジトリ（click）の計測結果です。コマンドの詳細は
            <a
              href={griftCli.github}
              target="_blank"
              rel="noreferrer"
              class="text-primary underline underline-offset-2">GitHub</a
            >
            をご覧ください。
          </figcaption>
        </figure>

        <aside class="surface-card p-5 sm:p-6 lg:p-8">
          <p class="section-kicker">あなたに合う読み方</p>
          <h2 class="mt-3 type-heading text-2xl font-semibold text-text">
            推薦する人にも、推薦される人にも。
          </h2>
          <p class="mt-4 type-copy text-sm text-text-muted">
            Griftを使うのは、候補者を企業へ推薦する営業の方と、自分の仕事を確かめられる形で示したいエンジニアの方です。
          </p>
          <div class="mt-6 grid gap-3">
            {
              audiences.map((audience) => (
                <a
                  href={`#${audience.id}`}
                  class="group rounded-2xl border border-border bg-background p-4 no-underline transition duration-200 ease-out hover:-translate-y-1 hover:border-primary/40"
                >
                  <p class="text-xs font-semibold text-primary">{audience.label}</p>
                  <p class="mt-1 type-heading text-sm font-semibold text-text group-hover:text-primary">
                    {audience.title}
                  </p>
                </a>
              ))
            }
          </div>
          <a
            href="/faq/"
            class="mt-5 inline-flex text-sm font-semibold text-primary hover:underline"
          >
            よくある質問を読む →
          </a>
        </aside>
      </div>
    </div>
    {/* 下にコンテンツが続くことを示すスクロールヒント（装飾・読み上げ対象外） */}
    <div
      class="scroll-hint pointer-events-none absolute inset-x-0 bottom-4 hidden justify-center sm:flex"
      aria-hidden="true"
    >
      <span class="scroll-hint-arrow text-2xl text-text-muted/50">↓</span>
    </div>
  </section>
  <div class="hero-accent-line" aria-hidden="true"></div>

  <PageToc items={tocItems} />

  {
    /* AIO/回答エンジン向け: 「Griftとは」を自己完結で説明する定義ブロック。
      dl 構造で要点を機械可読に整理する。 */
  }
  <section id="about" class="section-animate border-b border-border bg-background">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-20 lg:px-8">
      <div class="fade-in-section grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div class="space-y-4">
          <p class="text-sm font-semibold text-primary">Griftとは</p>
          <h2 class="text-3xl font-semibold text-balance text-text sm:text-4xl">
            git履歴から、確かめられる事実を取り出すOSSのツール。
          </h2>
          <p class="text-pretty text-lg leading-8 text-text-muted">
            Grift（グリフト）は、Cor.株式会社が開発・公開しているコマンドラインツール（Grift
            CLI）です。エンジニアのgit履歴から、誰の仕事か・変更に検証が伴っているかといった事実を、AI（LLM）を使わずに取り出します。点数や順位はつけず、受け取った側が同じ条件で再計算して検算できます。
          </p>
          <p class="text-sm text-text-muted">情報は{asOfLabel}時点のものです。</p>
        </div>
        <dl class="stagger-children grid gap-3 sm:grid-cols-2">
          {
            griftFacts.map((fact) => (
              <div class="rounded-2xl border border-border bg-surface p-5">
                <dt class="text-sm font-semibold text-primary">{fact.term}</dt>
                <dd class="mt-2 text-sm leading-7 text-text-muted text-pretty">{fact.detail}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <ServiceMessageSection />

  <section
    id="problem"
    class="section-animate mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-24 lg:px-8"
  >
    <div class="fade-in-section max-w-3xl space-y-4">
      <p class="text-sm font-semibold text-primary">課題</p>
      <h2 class="max-w-2xl text-3xl font-semibold leading-[1.18] text-text sm:text-4xl">
        経歴書と面談だけでは、伝わらないことがある。
      </h2>
      <p class="text-lg leading-8 text-text-muted text-pretty">
        推薦する側も、推薦される側も、「確かめられる材料」が足りないまま話を進めています。
      </p>
    </div>
    <div class="stagger-children mt-10 grid gap-6 lg:grid-cols-2 xl:grid-cols-4">
      {
        pains.map((item) => (
