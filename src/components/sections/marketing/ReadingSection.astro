---
/**
 * ReadingSection - トップから「思想の記事」と「コラム」へ回遊させる読みものの入口
 *
 * 思想の記事（Qiita・note、外部）と注目コラム（内部）をカードで並べ、カード全体をリンクにする。
 * トップの中ほど（開発の背景の直後）に置き、ページ末尾まで読まなくても見つかるようにする。
 */
import { columnArticles, griftArticles } from '@/config';

const articleNotes: Record<(typeof griftArticles)[number]['platform'], string> = {
  Qiita: '代表・寺田康佑の記事（Qiita）',
  note: 'note の記事',
};

const featuredColumns = columnArticles
  .filter((article) => article.featured)
  .map((article) => ({
    href: article.href,
    title: article.landingTitle ?? article.title,
    category: article.landingCategory ?? article.category,
    summary: article.landingSummary ?? article.summary,
  }));
---

<section id="reading" class="section-animate landing-section border-y border-border bg-surface">
  <div class="landing-container">
    <div class="fade-in-section max-w-3xl space-y-4">
      <p class="section-kicker">思想とコラム</p>
      <h2 class="type-heading text-3xl font-semibold text-text sm:text-4xl">
        なぜ点数にしないのか。記事とコラムで、もう少し詳しく。
      </h2>
      <p class="type-copy text-lg text-text-muted">
        Griftの考え方は記事で、受託開発の見積・要件定義の実務はコラムで紹介しています。
      </p>
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <h3 class="text-lg font-semibold text-text">Griftの思想</h3>
        <ul class="stagger-children mt-4 grid gap-3">
          {
            griftArticles.map((article) => (
              <li>
                <a
                  href={article.url}
                  target="_blank"
                  rel="noreferrer"
                  class="group flex h-full items-center justify-between gap-4 rounded-2xl border border-border bg-background p-5 no-underline transition duration-200 ease-out hover:-translate-y-1 hover:border-primary/45 hover:shadow-md"
                >
                  <span>
                    <span class="block text-base font-semibold text-text group-hover:text-primary">
                      Griftの思想を{article.platform}で読む
                    </span>
                    <span class="mt-1 block text-sm text-text-muted">
                      {articleNotes[article.platform]}
                    </span>
                  </span>
                  <span class="shrink-0 text-lg text-primary" aria-hidden="true">
                    ↗
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-lg font-semibold text-text">コラム（受託開発の見積・要件定義）</h3>
        <ol class="stagger-children mt-4 grid gap-3 sm:grid-cols-2">
          {
            featuredColumns.map((article) => (
              <li>
                <a
                  href={article.href}
                  class="group flex h-full flex-col gap-3 rounded-2xl border border-border bg-background p-5 no-underline transition duration-200 ease-out hover:-translate-y-1 hover:border-primary/45 hover:shadow-md"
                >
                  <span class="w-fit rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
                    {article.category}
                  </span>
                  <span class="type-heading text-base font-semibold text-text group-hover:text-primary">
                    {article.title}
                  </span>
                  <span class="type-copy text-sm text-text-muted">{article.summary}</span>
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="/column/"
              class="group flex h-full flex-col justify-center gap-2 rounded-2xl border border-primary/30 bg-primary/5 p-5 no-underline transition duration-200 ease-out hover:-translate-y-1 hover:border-primary/60 hover:shadow-md"
            >
              <span class="text-base font-semibold text-primary">
                コラムをすべて見る（{columnArticles.length}本） →
              </span>
              <span class="text-sm text-text-muted">
                見積・要件定義・AI開発費用・上流工程の解説をまとめています。
              </span>
            </a>
          </li>
        </ol>
      </div>
    </div>
  </div>
</section>
