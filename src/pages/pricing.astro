---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import PageHeader from '@sections/content/PageHeader.astro';
import BreadcrumbNav from '@/components/common/BreadcrumbNav.astro';
import NextStep from '@/components/common/NextStep.astro';
import DocumentDownload from '@/components/common/DocumentDownload.astro';
import { Icon } from 'astro-icon/components';
import { griftCli, siteConfig } from '@/config';
import { corCta } from '@/lib/cor-cta';

const contactUrl = corCta.griftTrial('grift-pricing');

// 旧プラン（Team Beta / Paid Trial / Estimate Audit）は 2026-10 に取り下げた。
// 正式版の価格は決まるまで載せない（金額を出すときは「予定」と分かる表現にする）。
const offerings = [
  {
    name: 'Grift CLI',
    target: 'エンジニア本人・どなたでも',
    price: '無償',
    priceNote: 'MITライセンスのOSS',
    description:
      'git履歴から確かめられる事実を取り出すコマンドラインツールです。手元のPCだけで動き、当社へデータを自動で送る機能はありません。',
    features: [
      `${griftCli.installCommand} でインストール（Python ${griftCli.pythonRequires}）`,
      'AI（LLM）を使わない決定論的な計測',
      'grift verify による再計算での検算',
      '指標の定義・検証結果・利用規範を公開',
    ],
    cta: 'GitHubでGrift CLIを見る',
    href: griftCli.github,
    primary: false,
  },
  {
    name: '紹介会社さま向けのテスト導入（PoC）',
    target: '人材紹介会社・SES企業',
    price: '個別にご案内',
    priceNote: '対象・件数に応じて',
    description:
      '候補者本人が共有した記録をもとに、推薦の理由を根拠とともに伝える流れを、実際の推薦業務で試していただく取り組みです。',
    features: [
      'テストの範囲（対象の職種・件数・期間）を一緒に決めます',
      '営業向けの画面はテスト導入に向けて準備中です',
      '候補者の同意と共有の手順を含めて設計します',
      '費用は範囲が決まってから個別にお見積りします',
    ],
    cta: '自社でテストしてみる',
    href: contactUrl,
    primary: true,
  },
];

const pricingFaqs = [
  {
    question: '料金はいくらですか？',
    answer:
      'Grift CLI は無償（MITライセンス）です。紹介会社さま・SES企業さまのテスト導入（PoC）は、対象・件数に応じて個別にご案内しています。正式版の価格は、決まってからこのページでお知らせします。',
  },
  {
    question: '正式版はいつ提供されますか？',
    answer:
      'テスト導入の結果をふまえて、2027年の提供開始を目指しています。時期と価格が決まりしだいお知らせします。',
  },
  {
    question: '以前案内していた Team Beta・Paid Trial・Estimate Audit はどうなりましたか？',
    answer:
      '2026年10月に取り下げました。Griftは方針を変え、見積支援のWebアプリに代えて、git履歴から確かめられる事実を取り出すCLIと、紹介会社さま向けの推薦支援に取り組んでいます。以前のプランについてのお問い合わせも、AI受付でお受けします。',
  },
  {
    question: 'エンジニア本人に費用はかかりますか？',
    answer:
      'かかりません。Grift CLI は無償で使えます。収益は、テスト導入と正式版をご利用いただく紹介会社さま・SES企業さまからいただく想定です。',
  },
];

const trialSteps = [
  {
    title: 'お問い合わせ',
    body: '推薦業務の流れと、いま困っていることをお聞かせください。',
  },
  {
    title: 'テストの範囲を決める',
    body: '対象の職種・件数・期間と、候補者の同意の取り方を一緒に決め、費用をご案内します。',
  },
  {
    title: '推薦業務で試す',
    body: '候補者本人が手元で実行した結果をもとに、推薦の理由を根拠とともに伝える流れを試します。',
  },
];
---

<MarketingLayout
  title={`料金と提供状況 — Grift CLI は無償、紹介会社さま向けのテスト導入は個別案内 | ${siteConfig.name}`}
  titleTag="料金と提供状況｜Grift"
  ogTitle="Griftの料金と提供状況｜Grift"
  description="Grift CLI は無償（MITライセンス）のOSSです。人材紹介会社・SES企業さまのテスト導入（PoC）は、対象・件数に応じて個別にご案内しています。正式版は2027年の提供開始を目指しています。"
  faqItems={pricingFaqs}
>
  <BreadcrumbNav items={[{ label: '料金と提供状況' }]} />
  <PageHeader
    title="料金と提供状況"
    subtitle="Grift CLI は無償。紹介会社さま・SES企業さまのテスト導入（PoC）は、対象・件数に応じて個別にご案内します。"
  />

  {/* AIO/回答エンジン向け: 料金の要点を自己完結の dl で先出しする */}
  <section class="border-b border-border bg-background">
    <div class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
      <div class="rounded-3xl border border-border bg-surface p-6 sm:p-8">
        <h2 class="text-xl font-bold text-text">料金の要点</h2>
        <p class="mt-3 text-pretty text-sm leading-7 text-text-muted">
          いまはCLIを公開し、紹介会社さま向けの機能をテスト導入に向けて準備している段階です。正式版は2027年の提供開始を目指しており、価格は決まってからお知らせします。
        </p>
        <dl class="mt-6 grid gap-4 sm:grid-cols-3">
          {
            offerings.map((item) => (
              <div class="rounded-2xl border border-border bg-background p-4">
                <dt class="text-sm font-semibold text-text">{item.name}</dt>
                <dd class="mt-1 text-xs text-text-muted">{item.target}</dd>
                <dd class="mt-2 text-base font-bold text-primary">{item.price}</dd>
              </div>
            ))
          }
          <div class="rounded-2xl border border-border bg-background p-4">
            <dt class="text-sm font-semibold text-text">正式版</dt>
            <dd class="mt-1 text-xs text-text-muted">紹介会社さま・SES企業さま</dd>
            <dd class="mt-2 text-base font-bold text-primary">2027年の提供開始を目指しています</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="bg-background py-section">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-5 lg:grid-cols-2">
        {
          offerings.map((item) => (
            <article class="card-lift relative flex h-full flex-col rounded-2xl border border-border bg-surface p-6 shadow-sm">
              <p class="text-lg font-semibold text-text">
                <a
                  href={item.href}
                  target="_blank"
                  rel="noreferrer"
                  class="after:absolute after:inset-0 after:rounded-2xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                >
                  {item.name}
                </a>
              </p>
              <p class="mt-2 text-sm font-semibold text-primary">{item.target}</p>
              <p class="mt-5 text-pretty text-sm leading-7 text-text-muted">{item.description}</p>
              <div class="mt-6">
                <p class="text-3xl font-bold text-text">{item.price}</p>
                <p class="mt-1 text-sm text-text-muted">{item.priceNote}</p>
              </div>
              <ul class="mt-7 flex-1 space-y-3 text-sm text-text-muted">
                {item.features.map((feature) => (
                  <li class="flex gap-3">
                    <Icon name="lucide:check" class="mt-0.5 size-4 shrink-0 text-primary" />
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
              <div class="mt-8 flex flex-col gap-2">
                <a
                  href={item.href}
                  target="_blank"
                  rel="noreferrer"
                  class:list={[
                    item.primary ? 'cta-primary' : 'cta-secondary',
                    'relative z-10 w-full text-sm',
                  ]}
                >
                  {item.cta}
                </a>
              </div>
            </article>
          ))
        }
      </div>
      <p class="mx-auto mt-6 max-w-3xl text-center text-sm leading-7 text-text-muted text-pretty">
        以前ご案内していた Team Beta・Paid Trial・Estimate Audit は、2026年10月に取り下げました。
      </p>
    </div>
  </section>

  <section class="bg-background py-section">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 text-center">
        <h2 class="text-2xl font-bold text-balance text-text sm:text-3xl">よくある質問</h2>
      </div>
      <div class="space-y-4">
        {
          pricingFaqs.map((faq) => (
            <details class="group rounded-2xl border border-border bg-surface">
              <summary class="flex cursor-pointer list-none items-center justify-between p-5 transition-colors hover:bg-surface/80 [&::-webkit-details-marker]:hidden">
                <span class="pr-4 font-medium text-text">{faq.question}</span>
                <span class="shrink-0 text-text-muted transition-transform group-open:rotate-180">
                  <Icon name="lucide:chevron-down" class="size-5" />
                </span>
              </summary>
              <div class="px-5 pb-5 text-pretty leading-7 text-text-muted">{faq.answer}</div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-surface py-section">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl border border-border bg-background p-8 sm:p-10">
        <p class="text-sm font-semibold text-primary">テスト導入の進め方</p>
        <h2 class="mt-3 text-balance text-3xl font-bold text-text sm:text-4xl">
          お問い合わせからテストまで、3ステップで進みます。
        </h2>
        <ol class="mt-8 grid gap-4 lg:grid-cols-3">
          {
            trialSteps.map((step, index) => (
              <li class="rounded-2xl border border-border bg-surface p-5">
                <p class="text-sm font-semibold text-primary">STEP {index + 1}</p>
                <h3 class="mt-2 text-lg font-semibold text-text">{step.title}</h3>
                <p class="mt-2 text-pretty text-sm leading-7 text-text-muted">{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="bg-background pb-section">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <DocumentDownload />
    </div>
  </section>

  <NextStep
    heading="推薦業務で使えるか、自社でテストしてみませんか。"
    lead="推薦の流れをお聞かせいただければ、テストの範囲と費用を個別にご案内します。"
    ctas={[
      { label: '自社でテストしてみる', href: contactUrl, primary: true, isExternal: true },
      { label: 'GitHubでGrift CLIを見る', href: griftCli.github, isExternal: true },
      { label: 'よくある質問を見る', href: '/faq/' },
    ]}
  />
</MarketingLayout>
