---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import PageHeader from '@sections/content/PageHeader.astro';
import BreadcrumbNav from '@/components/common/BreadcrumbNav.astro';
import NextStep from '@/components/common/NextStep.astro';
import DocumentDownload from '@/components/common/DocumentDownload.astro';
import { Icon } from 'astro-icon/components';
import { griftCli, siteConfig, tepComparisonSummary, tepFacts } from '@/config';
import { corCta } from '@/lib/cor-cta';

const contactUrl = corCta.griftTrial('grift-faq');

interface FaqItem {
  question: string;
  answer: string;
  /** 答えのあとに出す、くわしい説明へのリンク（構造化データには入れない） */
  link?: { href: string; label: string };
}

const faqSections: Array<{ id: string; name: string; faqs: FaqItem[] }> = [
  {
    id: 'about-grift',
    name: 'Griftについて',
    faqs: [
      {
        question: 'Griftとは何ですか？',
        answer:
          'エンジニアのgit履歴から「確かめられる事実」を取り出すOSSのコマンドラインツール（Grift CLI）です。点数や順位はつけず、誰が実行しても同じ結果になり、受け取った側が検算できます。Cor.株式会社が開発・公開しています。',
      },
      {
        question: '誰のためのツールですか？',
        answer:
          '人材紹介会社・SESの営業の方が「なぜこの方を薦めるのか」を根拠とともに伝えるため、そしてエンジニア本人が経歴書に検算できる事実を添えるためのツールです。',
      },
      {
        question: 'TEPとは何ですか？',
        answer:
          'Griftが使っている方法の名前で、Technical Evidence Pipeline の略です。エンジニアのgit履歴から、誰の変更か、どの部分をどんなペースで変えたか、テストも一緒に変えたかといった事実を、誰が何度実行しても同じ結果になるように取り出します。点数や順位はつけません。利用規範（norms）を守る使い方だけを「TEP準拠」と呼びます。',
        link: { href: '/tep/', label: 'TEPとは（考え方と使い方）' },
      },
      {
        question: '以前の「AI見積支援ツール Grift」とは違うものですか？',
        answer:
          '同じ製品の方針を変えたものです。Griftは2026年2月に見積支援のWebアプリとして始まり、8月に計測の部分をCLIとして切り出し、9月に旧Webアプリの提供を止めました。いまは、git履歴から確かめられる事実を取り出すCLIと、紹介会社さま向けの推薦支援に取り組んでいます。',
      },
    ],
  },
  {
    id: 'how-it-works',
    name: '計測のしかた',
    faqs: [
      {
        question: 'AIでエンジニアを評価するのですか？',
        answer:
          'いいえ。計測にAI（LLM）は使いません。1つにまとめた点数（合成スコア）・順位・合否・等級も出しません。出すのは「何件のうち何件か」が付いた値（検査値）で、判断するのは人です。',
      },
      {
        question: '何を観測しますか？',
        answer: `git履歴から、誰の変更か（本人・ほかの人・bot・自動生成されたファイル・fork元から引き継いだ記録などの区別）、どの部分を変えたか（画面・サーバー側・データ・テスト・文書など${tepFacts.surfaceCount}の区分）、変更のペース（直近${tepFacts.rhythmWindowDays}日に変更を記録した日数と、変更の間隔）、テストも一緒に変えた割合とテストの種類、どんなリポジトリか（関わった人の数や取り込みの記録の割合など）を数えます。修正でのやり直しの割合も出しますが、傾向の記録として扱い、合否には使いません。指定したときだけ、いまのコードの新しさ（定着率）も出します。どの数値にも「何件のうち何件か」が付き、職種や能力を決めるものではありません。`,
        link: { href: '/tep/#what', label: 'TEPが見るもの（それぞれで分からないこと）' },
      },
      {
        question: '案件で求められることと、どう照らし合わせますか？',
        answer: `案件で求める作業の区分・テストの種類・変更のペースなどを、案件側が項目ごとに書き出します（grift project）。grift align はその要求と候補者の記録を項目ごとに並べ、${tepComparisonSummary}で示します。総合点・順位・合否は計算しません。「範囲外」は能力が足りないという意味ではなく、面談で聞くことを決める手がかりです。チームで見るとき（grift align --team）は要求を満たす人数だけを出し、${tepFacts.minTeamSize}人未満のチームでは集計しません。`,
        link: { href: '/tep/#use', label: '使い方と架空の例' },
      },
      {
        question: '同じリポジトリなら、本当に同じ結果になりますか？',
        answer:
          'はい。同じリポジトリ・同じ版のGriftなら、誰が実行しても同じ数値になります。保存したレポートは grift verify で同じ条件のまま再計算し、一致（VERIFIED）・不一致（MISMATCH）・検証不能（CANNOT_VERIFY）を確かめられます。',
      },
      {
        question: 'コミットが少ない人や、非公開（private）の仕事が多い人は不利になりませんか？',
        answer: `観測できなかったものは「実績なし」ではなく、理由付きの「未観測」として出します。数えた件数が${tepFacts.minCount}件に満たないときは、割合を出さずに件数だけを示します。gitに写らない仕事や非公開の経歴を不利に読む使い方は、利用規範で禁止しています。`,
      },
      {
        question: '指標の信頼性はどう確かめていますか？',
        answer:
          '公開117リポジトリで指標を検証し、区別できた比較と、まだ区別できていない比較の両方をGitHubで公開しています。社内での測定で、第三者による監査は受けていません。',
      },
    ],
  },
  {
    id: 'privacy',
    name: 'データと同意',
    faqs: [
      {
        question: 'リポジトリやコードはどこかに送られますか？',
        answer:
          'Grift CLI は手元のPCだけで動き、当社へデータを自動で送る機能はありません。公開リポジトリの情報を取りに行くなど、ネットワークを使う操作は本人が明示したときだけです。',
      },
      {
        question: '非公開（private）のリポジトリでも使えますか？',
        answer:
          '使えます。手元で計測し、共有したい集計値だけを本人の意思で渡せます。コードそのものを相手に見せる必要はありません。',
      },
      {
        question: '本人の同意なく、他人を測ってもよいですか？',
        answer:
          '本人の同意なく個人の分析をする使い方は、利用規範で「非準拠」としています。紹介会社さまでのテスト導入でも、実行と共有は候補者本人が行う流れを前提にしています。',
      },
    ],
  },
  {
    id: 'pricing',
    name: '料金と導入',
    faqs: [
      {
        question: '料金はいくらですか？',
        answer:
          'Grift CLI は無償（MITライセンス）です。紹介会社さま・SES企業さまのテスト導入（PoC）は、対象・件数に応じて個別にご案内しています。正式版は2027年の提供開始を目指しており、価格は決まってからお知らせします。',
      },
      {
        question: 'どうやって始めればよいですか？',
        answer:
          'エンジニアの方は、Python 3.11以上の環境で pipx install grift-cli を実行し、リポジトリの中で grift report を実行してください。紹介会社さま・SES企業さまは、AI受付からテスト導入をお申し込みください。',
      },
      {
        question: 'Team Beta や Estimate Audit はまだ申し込めますか？',
        answer:
          '2026年10月に取り下げたため、新しいお申し込みは受け付けていません。以前のプランについてのお問い合わせは、AI受付でお受けします。',
      },
    ],
  },
];

const allFaqItems = faqSections.flatMap((section) => section.faqs);
---

<MarketingLayout
  title={`よくある質問 — git履歴から確かめられる事実を取り出す ${siteConfig.name}`}
  titleTag="Griftのよくある質問｜計測のしかた・データの扱い・料金"
  ogTitle="Griftのよくある質問｜Grift"
  description="Grift（Grift CLI）のよくある質問です。AIで人を評価するのか、何を観測するのか、データはどこへ行くのか、本人の同意、料金と始め方などをQ&A形式でまとめています。"
  faqItems={allFaqItems}
>
  <BreadcrumbNav items={[{ label: 'よくある質問' }]} />
  <PageHeader
    title="よくある質問"
    subtitle="Grift（Grift CLI）について、使う前に確認されやすい内容をまとめました。"
  />

  {/* カテゴリ別アンカーリンク（ページ内回遊・構造把握用） */}
  <nav aria-label="質問カテゴリ" class="border-b border-border bg-surface">
    <div class="mx-auto max-w-3xl px-4 py-5 sm:px-6 lg:px-8">
      <ol class="flex flex-wrap gap-x-2 gap-y-2">
        {
          faqSections.map((section) => (
            <li>
              <a
                href={`#${section.id}`}
                class="inline-flex items-center rounded-full border border-border bg-background px-4 py-1.5 text-sm font-medium text-text-muted transition hover:border-primary/50 hover:text-primary"
              >
                {section.name}
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </nav>

  <section class="bg-background py-section">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      {
        faqSections.map((section) => (
          <div id={section.id} class="mb-12 last:mb-0">
            <h2 class="mb-6 border-b border-border pb-2 text-xl font-bold text-text">
              {section.name}
            </h2>
            <div class="space-y-4">
              {section.faqs.map((faq) => (
                <details class="group rounded-2xl border border-border bg-surface">
                  <summary class="flex cursor-pointer list-none items-center justify-between p-5 transition-colors hover:bg-surface/80 [&::-webkit-details-marker]:hidden">
                    <span class="pr-4 font-medium text-text">{faq.question}</span>
                    <span class="shrink-0 text-text-muted transition-transform group-open:rotate-180">
                      <Icon name="lucide:chevron-down" class="size-5" />
                    </span>
                  </summary>
                  <div class="px-5 pb-5 text-pretty leading-7 text-text-muted">
                    <p>{faq.answer}</p>
                    {faq.link && (
                      <p class="mt-3 text-sm">
                        <a href={faq.link.href} class="font-semibold text-primary hover:underline">
                          {faq.link.label} →
                        </a>
                      </p>
                    )}
                  </div>
                </details>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-background pb-section">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <DocumentDownload />
    </div>
  </section>

  <NextStep
    heading="推薦業務で使えるか、自社でテストしてみませんか。"
    lead="紹介会社さま・SES企業さまの推薦の流れをお聞かせいただければ、テストの範囲と費用を個別にご案内します。"
    ctas={[
      { label: '自社でテストしてみる', href: contactUrl, primary: true, isExternal: true },
      { label: 'GitHubでGrift CLIを見る', href: griftCli.github, isExternal: true },
      { label: '料金と提供状況を見る', href: '/pricing/' },
    ]}
  />
</MarketingLayout>
