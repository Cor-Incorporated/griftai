---
import { ClientRouter } from 'astro:transitions';
import SEO from '@components/common/SEO.astro';
import { analytics } from '@/config';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  titleTag?: string;
  ogTitle?: string;
  ogDescription?: string;
  // Article-specific props for JSON-LD
  publishedDate?: Date;
  modifiedDate?: Date;
  author?: string;
  tags?: string[];
}

const {
  title,
  description,
  image,
  type = 'website',
  titleTag,
  ogTitle,
  ogDescription,
  publishedDate,
  modifiedDate,
  author,
  tags,
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2ea9dd" />
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      titleTag={titleTag}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      publishedDate={publishedDate}
      modifiedDate={modifiedDate}
      author={author}
      tags={tags}
    />
    <meta name="google-site-verification" content="OttHDtQkiKDUNOCtDrvci_9l4_DpgbUc65j8UDtS5mA" />
    <ClientRouter />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {
      /* Google Analytics（GA4）と Microsoft Clarity。イベントの列（dataLayer）はどのホストでも用意し、
        タグを読み込んで送るのは本番のホストだけ（config/analytics.ts）。 */
    }
    <script
      is:inline
      define:vars={{
        ga4Id: analytics.ga4MeasurementId,
        clarityId: analytics.clarityProjectId,
        productionHosts: analytics.productionHosts,
      }}
    >
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      if (productionHosts.includes(window.location.hostname)) {
        const gtagScript = document.createElement('script');
        gtagScript.async = true;
        gtagScript.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
        document.head.appendChild(gtagScript);
        window.gtag('js', new Date());
        window.gtag('config', ga4Id);

        (function (c, l, a, r, i, t, y) {
          c[a] =
            c[a] ||
            function () {
              (c[a].q = c[a].q || []).push(arguments);
            };
          t = l.createElement(r);
          t.async = 1;
          t.src = 'https://www.clarity.ms/tag/' + i;
          y = l.getElementsByTagName(r)[0];
          y.parentNode.insertBefore(t, y);
        })(window, document, 'clarity', 'script', clarityId);
      }
    </script>
  </head>
  <body class="min-h-screen bg-background text-text antialiased">
    <!-- Skip to main content link for accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-white focus:rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
    >
      メインコンテンツへ移動
    </a>
    <slot />

    <script>
      import { describeTrackedClick } from '@/lib/analytics-events';
      import { getCorBaseUrl } from '@/lib/cor-cta';

      // 問い合わせへの CTA と資料のダウンロードのクリックを、GA4 と Clarity のイベントにする。
      // document は ClientRouter のページ遷移で差し替わらないので、リスナーは一度だけ付ける。
      const placementOf = (link: Element): string => {
        const section = link.closest('section[id]');
        if (section) return section.id;
        if (link.closest('header')) return 'header';
        if (link.closest('footer')) return 'footer';
        return 'page';
      };

      const trackClick = (event: MouseEvent): void => {
        // auxclick は中ボタン（新しいタブで開く）だけを数え、右クリックは数えない
        if (event.type === 'auxclick' && event.button !== 1) return;
        const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
        if (!(link instanceof HTMLAnchorElement)) return;
        const tracked = describeTrackedClick({
          href: link.href,
          placement: placementOf(link),
          siteOrigin: window.location.origin,
          corOrigin: getCorBaseUrl(),
        });
        if (!tracked) return;
        window.gtag?.('event', tracked.name, tracked.params);
        window.clarity?.('event', tracked.name);
      };

      document.addEventListener('click', trackClick, { capture: true });
      document.addEventListener('auxclick', trackClick, { capture: true });
    </script>
  </body>
</html>
