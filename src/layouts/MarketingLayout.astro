---
import BaseLayout from './BaseLayout.astro';
import Header from '@layout/Header.astro';
import Footer from '@layout/Footer.astro';
import AnnouncementBar from '@layout/AnnouncementBar.astro';
import StructuredData from '@components/common/StructuredData.astro';
import ScrollChrome from '@components/common/ScrollChrome.astro';
import { siteConfig } from '@/config';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  titleTag?: string;
  ogTitle?: string;
  ogDescription?: string;
  // Article-specific props for JSON-LD
  publishedDate?: Date;
  modifiedDate?: Date;
  author?: string;
  tags?: string[];
  faqItems?: Array<{ question: string; answer: string }>;
}

const {
  title,
  description,
  image,
  type = 'website',
  titleTag,
  ogTitle,
  ogDescription,
  publishedDate,
  modifiedDate,
  author,
  tags,
  faqItems,
} = Astro.props;

const { announcement } = siteConfig;
const isHome = Astro.url.pathname === '/';
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  type={type}
  titleTag={titleTag}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  publishedDate={publishedDate}
  modifiedDate={modifiedDate}
  author={author}
  tags={tags}
>
  {
    /* Organization schema は SEO.astro が全ページに @id 付きで出力するため、
      ここでは重複発行しない（SoftwareApplication / FAQ / HowTo のみ）。 */
  }
  {isHome && <StructuredData type="software" />}
  {faqItems && faqItems.length > 0 && <StructuredData type="faq" faqItems={faqItems} />}
  <div class="flex flex-col min-h-screen">
    {
      announcement.enabled && (
        <AnnouncementBar
          id={announcement.id}
          text={announcement.text}
          href={announcement.href}
          linkText={announcement.linkText}
          variant={announcement.variant}
          dismissible={announcement.dismissible}
        />
      )
    }
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </div>
  <ScrollChrome />

  <script>
    let revealOnScroll: (() => void) | null = null;

    const initScrollAnimations = (): void => {
      // View Transitions のページ遷移では前ページのリスナーを破棄してから再構築する
      if (revealOnScroll) {
        window.removeEventListener('scroll', revealOnScroll);
        revealOnScroll = null;
      }

      const targets = document.querySelectorAll(
        '.section-animate, .fade-in-section, .stagger-children'
      );
      if (targets.length === 0) return;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) {
        for (const el of targets) {
          el.classList.add('is-visible');
        }
        return;
      }

      // 高速スクロールやジャンプでも取りこぼさないよう、IOではなく
      // スクロール位置で「上端がビューポート下端を越えた要素」を確定的に表示する
      let ticking = false;
      const reveal = (): void => {
        const revealLine = window.innerHeight - 40;
        for (const el of targets) {
          if (el.classList.contains('is-visible')) continue;
          if (el.getBoundingClientRect().top < revealLine) {
            el.classList.add('is-visible');
          }
        }
      };
      revealOnScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          reveal();
          ticking = false;
        });
      };
      window.addEventListener('scroll', revealOnScroll, { passive: true });
      reveal();
    };

    // 初回表示 + ClientRouter のページ遷移後の両方で発火させる
    document.addEventListener('astro:page-load', initScrollAnimations);
  </script>
</BaseLayout>
