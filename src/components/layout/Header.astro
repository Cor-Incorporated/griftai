---
import { siteConfig, siteLinkFor } from '@/config';
import { Icon } from 'astro-icon/components';
import type { FeatureFlags } from '@/lib/types';

const { features, navigation } = siteConfig;
const { header: headerNav } = navigation;

const mainNavItems = headerNav.main.filter(
  (item) => !item.feature || features[item.feature as keyof FeatureFlags]
);

const ghostCTAs = headerNav.cta.filter((cta) => cta.variant === 'ghost');
const primaryCTA = headerNav.cta.find((cta) => cta.variant === 'primary');
const hasMobileMenu = mainNavItems.length > 0 || ghostCTAs.length > 0;
// 戻る link の URL は site-chrome.json の sites（id: "cor"）が持ち主。
const corHomeUrl = siteLinkFor('cor').href;
---

<header
  id="site-header"
  class="sticky top-0 z-50 h-14 border-b border-border bg-background lg:h-16"
>
  <nav
    class="mx-auto flex h-full max-w-7xl items-center gap-2 px-3 lg:gap-4 lg:px-6 xl:gap-6"
    aria-label="Main navigation"
  >
    <a
      href="/"
      aria-label={`${siteConfig.name} トップ`}
      class="flex shrink-0 items-center text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    >
      <img
        src="/grift-mark-120.jpg"
        alt=""
        width="40"
        height="40"
        class="size-10 rounded-sm"
        loading="eager"
      />
    </a>

    {
      mainNavItems.length > 0 && (
        <div class="hidden min-w-0 flex-1 items-center justify-center gap-1 lg:flex xl:gap-2">
          {mainNavItems.map((item) => (
            <a
              href={item.href}
              target={item.href.startsWith('http') ? '_blank' : undefined}
              rel={item.href.startsWith('http') ? 'noreferrer' : undefined}
              class="whitespace-nowrap rounded-full px-2 py-2 text-sm font-medium text-text-muted transition-colors hover:bg-surface hover:text-text focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background focus:outline-none xl:px-3"
            >
              {item.label}
            </a>
          ))}
        </div>
      )
    }

    <div class="ml-auto hidden shrink-0 items-center gap-3 lg:flex">
      {
        ghostCTAs.map((cta) => (
          <a
            href={cta.href}
            target="_blank"
            rel="noreferrer"
            class="rounded-full px-3 py-2 text-sm font-medium text-text-muted transition-colors hover:bg-surface hover:text-text focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background focus:outline-none"
          >
            {cta.label}
          </a>
        ))
      }
      <a
        href={corHomeUrl}
        rel="noopener"
        class="inline-flex h-11 min-w-11 items-center justify-center gap-1.5 rounded-full border border-primary bg-transparent px-3.5 text-sm font-semibold text-primary no-underline transition-colors hover:bg-primary/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        <span aria-hidden="true">←</span>
        <span>Cor. のサイトへ</span>
      </a>
      {
        primaryCTA && (
          <a
            href={primaryCTA.href}
            target="_blank"
            rel="noreferrer"
            class="cta-primary header-cta whitespace-nowrap px-5 text-sm"
          >
            {primaryCTA.label}
          </a>
        )
      }
    </div>

    <div class="ml-auto flex items-center gap-3 lg:hidden">
      {
        !hasMobileMenu && primaryCTA && (
          <a
            href={primaryCTA.href}
            target="_blank"
            rel="noreferrer"
            class="cta-primary px-4 py-2 text-xs sm:text-sm"
          >
            {primaryCTA.label}
          </a>
        )
      }
      {
        hasMobileMenu && (
          <button
            id="mobile-menu-button"
            type="button"
            aria-label="モバイルメニューを開く"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="inline-flex h-11 w-11 items-center justify-center rounded-full transition-colors hover:bg-surface focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
          >
            <Icon
              name="lucide:menu"
              id="menu-icon-open"
              class="h-6 w-6 text-text"
              aria-hidden="true"
            />
            <Icon
              name="lucide:x"
              id="menu-icon-close"
              class="hidden h-6 w-6 text-text"
              aria-hidden="true"
            />
          </button>
        )
      }
    </div>
  </nav>
</header>

{
  hasMobileMenu && (
    <div
      id="mobile-menu"
      class="fixed inset-0 z-40 hidden lg:hidden"
      role="dialog"
      aria-modal="true"
      aria-label="モバイルナビゲーション"
    >
      <div id="mobile-menu-backdrop" class="absolute inset-0 bg-background/90" />
      <nav
        id="mobile-menu-panel"
        class="absolute left-0 right-0 max-h-[calc(100dvh-3.5rem)] overflow-y-auto border-b border-background bg-surface shadow-lg"
        aria-label="モバイルナビゲーション"
      >
        <div class="space-y-1 px-4 py-4">
          <a
            href={corHomeUrl}
            rel="noopener"
            class="mb-2 inline-flex min-h-11 items-center justify-center gap-1.5 rounded-full border border-primary px-3.5 text-sm font-semibold text-primary no-underline focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            <span aria-hidden="true">←</span>
            <span>Cor. のサイトへ</span>
          </a>
          {mainNavItems.map((item) => (
            <a
              href={item.href}
              target={item.href.startsWith('http') ? '_blank' : undefined}
              rel={item.href.startsWith('http') ? 'noreferrer' : undefined}
              class="block rounded-md px-3 py-3 text-base font-medium text-text-muted transition-colors hover:bg-background hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset"
            >
              {item.label}
            </a>
          ))}
          {mainNavItems.length > 0 && ghostCTAs.length > 0 && (
            <div class="my-2 border-t border-border" />
          )}
          {ghostCTAs.map((cta) => (
            <a
              href={cta.href}
              target="_blank"
              rel="noreferrer"
              class="block rounded-md px-3 py-3 text-base font-medium text-text-muted transition-colors hover:bg-background hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset"
            >
              {cta.label}
            </a>
          ))}
          {primaryCTA && (
            <a
              href={primaryCTA.href}
              target="_blank"
              rel="noreferrer"
              class="block rounded-full bg-primary px-3 py-3 text-center text-base font-medium text-white transition-colors hover:bg-primary-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset"
            >
              {primaryCTA.label}
            </a>
          )}
        </div>
      </nav>
    </div>
  )
}

<style>
  #site-header .header-cta {
    height: 40px;
    min-height: 40px;
    padding: 0 18px;
  }
</style>

<script>
  import { onPageReady } from '@/lib/page-ready';

  function initHeader() {
    const header = document.getElementById('site-header');
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuPanel = document.getElementById('mobile-menu-panel');
    const mobileMenuBackdrop = document.getElementById('mobile-menu-backdrop');
    const menuIconOpen = document.getElementById('menu-icon-open');
    const menuIconClose = document.getElementById('menu-icon-close');

    if (!mobileMenuButton || !mobileMenu || !mobileMenuPanel || !mobileMenuBackdrop) return;

    function updateMenuPosition() {
      if (header && mobileMenuPanel) {
        const headerRect = header.getBoundingClientRect();
        mobileMenuPanel.style.top = `${headerRect.bottom}px`;
      }
    }

    function openMobileMenu() {
      updateMenuPosition();
      mobileMenu?.classList.remove('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'true');
      menuIconOpen?.classList.add('hidden');
      menuIconClose?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeMobileMenu() {
      mobileMenu?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    mobileMenuButton.addEventListener('click', () => {
      const isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMobileMenu();
      } else {
        openMobileMenu();
      }
    });

    mobileMenuBackdrop.addEventListener('click', closeMobileMenu);

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMobileMenu);
    });
  }

  // Escape は document リスナーなので、ページ遷移ごとの多重バインドを防ぐため一度だけ
  let escapeBound = false;
  function bindEscapeOnce() {
    if (escapeBound) return;
    document.addEventListener('keydown', (e) => {
      const mobileMenuButton = document.getElementById('mobile-menu-button');
      const mobileMenu = document.getElementById('mobile-menu');
      const menuIconOpen = document.getElementById('menu-icon-open');
      const menuIconClose = document.getElementById('menu-icon-close');
      if (e.key === 'Escape' && mobileMenuButton?.getAttribute('aria-expanded') === 'true') {
        mobileMenu?.classList.add('hidden');
        mobileMenuButton.setAttribute('aria-expanded', 'false');
        menuIconOpen?.classList.remove('hidden');
        menuIconClose?.classList.add('hidden');
        document.body.style.overflow = '';
        mobileMenuButton.focus();
      }
    });
    escapeBound = true;
  }

  // 初回はすぐに、ClientRouter のページ遷移後は再バインド（DOM は差し替わるため毎回実行）
  onPageReady(() => {
    initHeader();
    bindEscapeOnce();
  });
</script>
