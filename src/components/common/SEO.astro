---
import { siteConfig } from '@/config';
import { getRobotsMetaContent } from '@/lib/site-env';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  titleTag?: string;
  ogTitle?: string;
  ogDescription?: string;
  publishedDate?: Date;
  modifiedDate?: Date;
  author?: string;
  tags?: string[];
}

const {
  title,
  description,
  image,
  type = 'website',
  titleTag,
  ogTitle,
  ogDescription,
  publishedDate,
  modifiedDate,
  author,
  tags = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, siteConfig.url);
const fullTitle = `${title} | ${siteConfig.name}`;
const documentTitle = titleTag || fullTitle;
const socialTitle = ogTitle || documentTitle;
const socialDescription = ogDescription || description;
const imageUrl = image || siteConfig.ogImage || undefined;
const ogImage = imageUrl ? new URL(imageUrl, siteConfig.url).href : undefined;
const isDefaultOgImage = imageUrl === siteConfig.ogImage;
const ogImageAlt = socialTitle;
// https://x.com/<handle> → @<handle>（twitter:site は @付きハンドル形式）
const twitterHandle = siteConfig.social.twitter?.match(/(?:x\.com|twitter\.com)\/([^/?]+)/)?.[1];
const twitterSite = twitterHandle ? `@${twitterHandle.replace(/^@/, '')}` : undefined;

// エンティティ参照（AIO/ナレッジグラフ向けに @id で相互リンク）
const ORG_ID = `${siteConfig.url}/#organization`;
const WEBSITE_ID = `${siteConfig.url}/#website`;
const SOFTWARE_ID = `${siteConfig.url}/#software`;
const contactAddress = siteConfig.contact.address;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': WEBSITE_ID,
  name: siteConfig.name,
  description: siteConfig.description,
  url: siteConfig.url,
  inLanguage: 'ja-JP',
  publisher: { '@id': ORG_ID },
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': ORG_ID,
  name: siteConfig.author,
  legalName: 'Cor.株式会社',
  alternateName: ['Cor.inc', 'Cor株式会社'],
  url: 'https://cor-jp.com',
  logo: new URL('/grift-wordmark.jpg', siteConfig.url).href,
  description: '受託開発チーム向けAI見積支援ツール「Grift」を提供する、福岡発のAI・DX支援企業。',
  email: 'company@cor-jp.com',
  telephone: '+81-50-1792-9351',
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${contactAddress.city}${contactAddress.street}`,
    addressLocality: '福岡市',
    addressRegion: contactAddress.state,
    postalCode: contactAddress.zip,
    addressCountry: 'JP',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    telephone: '+81-50-1792-9351',
    email: 'company@cor-jp.com',
    availableLanguage: ['Japanese'],
  },
  sameAs: ['https://cor-jp.com', siteConfig.social.github, siteConfig.social.twitter].filter(
    Boolean
  ),
  founder: {
    '@type': 'Person',
    name: '寺田康佑',
    alternateName: ['Kosuke Terada', 'terisuke'],
    jobTitle: '代表取締役',
    worksFor: { '@id': ORG_ID },
  },
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonicalURL.href}#webpage`,
  url: canonicalURL.href,
  name: documentTitle,
  description,
  isPartOf: { '@id': WEBSITE_ID },
  about: { '@id': SOFTWARE_ID },
  inLanguage: 'ja-JP',
  breadcrumb: { '@id': `${canonicalURL.href}#breadcrumb` },
  ...(ogImage && { primaryImageOfPage: ogImage }),
};

const articleSchema =
  type === 'article' && publishedDate
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description,
        image: ogImage,
        datePublished: publishedDate.toISOString(),
        dateModified: (modifiedDate || publishedDate).toISOString(),
        author: {
          '@type': 'Person',
          name: author || siteConfig.author,
        },
        publisher: {
          '@type': 'Organization',
          name: siteConfig.name,
        },
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': `${canonicalURL.href}#webpage`,
        },
        keywords: tags.join(', '),
      }
    : null;

// GMO 納品コラム配下では、ページ本体の microdata が独自の 3 階層 breadcrumb
// (Top → コラム一覧 → 記事) を持つため、SEO.astro 側の 2 階層自動 schema を
// 出すと Google が複数の breadcrumb を観測して rich result を取り合う。
// 当面はページ側 microdata を権威ソースとし、ここでは出力しない。
const skipAutoBreadcrumbPaths = new Set([
  '/column/',
  '/ai-estimate-automation/',
  '/ai-tool-requirement-definition/',
  '/automation-ai-develop-estimate/',
  '/automation-tool-requirement/',
  '/basis-estimate-automation/',
  '/cost-ai-develop-estimate/',
  '/create-estimate-automation/',
  '/market-price-ai-develop/',
  '/requirement-definition-ai/',
  '/tool-upstream-process-ai/',
]);
const shouldEmitAutoBreadcrumb = !skipAutoBreadcrumbPaths.has(Astro.url.pathname);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${canonicalURL.href}#breadcrumb`,
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'ホーム',
      item: siteConfig.url,
    },
    ...(Astro.url.pathname !== '/'
      ? [
          {
            '@type': 'ListItem',
            position: 2,
            name: title,
            item: canonicalURL.href,
          },
        ]
      : []),
  ],
};
---

<title>{documentTitle}</title>
<meta name="title" content={documentTitle} />
<meta name="description" content={description} />
<meta name="author" content={siteConfig.author} />
<meta name="robots" content={getRobotsMetaContent()} />
<meta
  name="keywords"
  content={tags.length > 0
    ? tags.join(', ')
    : 'AI見積支援,受託開発,見積根拠,参考見積,開発見積ツール,Team Beta,GitHub連携,市場相場'}
/>

<link rel="canonical" href={canonicalURL} />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={socialDescription} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content="ja_JP" />
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:secure_url" content={ogImage} />}
{ogImage && <meta property="og:image:alt" content={ogImageAlt} />}
{ogImage && isDefaultOgImage && <meta property="og:image:width" content="1200" />}
{ogImage && isDefaultOgImage && <meta property="og:image:height" content="630" />}
{
  type === 'article' && publishedDate && (
    <meta property="article:published_time" content={publishedDate.toISOString()} />
  )
}
{type === 'article' && author && <meta property="article:author" content={author} />}

<meta property="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
{twitterSite && <meta property="twitter:site" content={twitterSite} />}
{twitterSite && <meta property="twitter:creator" content={twitterSite} />}
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={socialTitle} />
<meta property="twitter:description" content={socialDescription} />
{ogImage && <meta property="twitter:image" content={ogImage} />}
{ogImage && <meta property="twitter:image:alt" content={ogImageAlt} />}

<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
{
  shouldEmitAutoBreadcrumb && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  )
}
{
  articleSchema && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  )
}
